FROM nvcr.io/nvidia/l4t-base:r36.2.0 AS builder

# install build tools + CUDA toolkit (for nvcc, NPP headers)
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    curl \
    git \
    cuda-toolkit-12-2 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/cuda/bin:/root/.cargo/bin:${PATH}"

# install rustup
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable

WORKDIR /workspace
COPY . .

RUN cargo build --release

# ---- runtime image ----
FROM nvcr.io/nvidia/l4t-base:r36.2.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    cuda-libraries-12-2 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

COPY --from=builder /workspace/target/release/assfid_ffed /usr/local/bin/assfid_ffed

CMD ["/usr/local/bin/assfid_ffed"]
